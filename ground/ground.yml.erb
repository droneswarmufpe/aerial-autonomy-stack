<% 
  headless = ENV.fetch('HEADLESS', 'false') == 'true'

  num_quads = ENV.fetch('NUM_QUADS', 1).to_i
  num_vtols = ENV.fetch('NUM_VTOLS', 0).to_i

  sim_subnet = ENV.fetch('SIM_SUBNET', '10.42')
  air_subnet = ENV.fetch('AIR_SUBNET', '10.22')
  sim_id = ENV.fetch('SIM_ID', '100')
  ground_id = ENV.fetch('GROUND_ID', '101')

  centralized = ENV.fetch('CENTRALIZED', 'false') == 'true'
  rcpilot = ENV.fetch('RCPILOT', 'false') == 'true'
  
  # EVAAT: evaat_embedded_py mounted at /aas/evaat (sim_run.sh's EVAAT=true), EVAAT_CONFIG relative to it
  evaat = ENV.fetch('EVAAT', 'false') == 'true'
  evaat_config = ENV.fetch('EVAAT_CONFIG', 'config/sitl/gcs.yml')
%>

name: ground

windows:
  <% if evaat %>
  - evaat_gcs:
      panes:
        - >-
          cd /aas/evaat &&
          flock native/evaat_codec/.aas_build.lock bash -c 'test -f native/evaat_codec/libevaat_codec.so || ./evaatctl build' &&
          unset TMUX && EVAAT_NO_VENV=1 ./evaatctl run gcs <%= evaat_config %> -y --here
  <% end %>

  - ground:

  <% if not centralized %>
      layout: even-horizontal
      panes:
        - clear && echo "So nice to have you with us, this is the ground container."

  <% end %>

  <% if centralized %>
  <% num_quads.times do |i| %>
  <% drone_id = i + 1 %>
  - mavlink_router_quad_<%= drone_id %>:
      layout: even-horizontal
      panes:
        - clear && echo "Running in centralized mode, all processes are running in this ground container."
        - <%
          ground_ip = "#{sim_subnet}.90.#{ground_id}"
          master_port = 14570 + drone_id
          slave_port_1 = 14000 + 100 * drone_id
          slave_port_2 = 14001 + 100 * drone_id
          %>
          mavlink-routerd <%= ground_ip %>:<%= master_port %> -e <%= ground_ip %>:<%= slave_port_1 %> -e <%= ground_ip %>:<%= slave_port_2 %>
  <% end %>
  <% end %>
  
  <% if rcpilot && centralized %>
  - rcpilot:
      layout: even-horizontal
      panes:
        <% num_quads.times do |i| %>
        - >
          python3 -c "import yaml; cfg = yaml.safe_load(open('/workspaces/rcpilot/install/bringup/share/bringup/config/config.dev.yaml')); cfg['communication']['mavsys']['ros__parameters']['clients']['drone']['connection_string'] = 'udp:<%= "#{sim_subnet}.90.#{ground_id}" %>:<%= 14000 + 100 * (i + 1) %>'; yaml.dump(cfg, open('/workspaces/rcpilot/install/bringup/share/bringup/config/config.dev.yaml', 'w'))" &&
          ros2 launch bringup rcpilot.dev.launch.py
        <% end %>
        <% num_vtols.times do |i| %>
        - >
          python3 -c "import yaml; cfg = yaml.safe_load(open('/workspaces/rcpilot/install/bringup/share/bringup/config/config.dev.yaml')); cfg['communication']['mavsys']['ros__parameters']['clients']['drone']['connection_string'] = 'udp:<%= "#{sim_subnet}.90.#{ground_id}" %>:<%= 14000 + 100 * (num_quads + i + 1) %>'; yaml.dump(cfg, open('/workspaces/rcpilot/install/bringup/share/bringup/config/config.dev.yaml', 'w'))" &&
          ros2 launch bringup rcpilot.dev.launch.py
        <% end %>
  <% end %>

  <% if rcpilot %>
  <%
    # The API talks to the rcpilot gateway over UDP (sends to port 50051, receives on 14556): the gateway runs in this
    # container in centralized mode, otherwise in the first aircraft container (the API holds a single gateway target)
    gcs_udp = centralized ? { mode: 'localhost', host: 'localhost' } : { mode: 'ip-targeted', host: "#{sim_subnet}.90.1" }
  %>
  - rcpilot_gcs:
      layout: even-horizontal
      panes:
        - >-
          uvicorn rcpilot.api.main:app --host 127.0.0.1 --port 8199 --no-access-log &
          until curl -sf -o /dev/null http://127.0.0.1:8199/gateway/config; do sleep 1; done &&
          curl -sf -X POST -H 'Content-Type: application/json'
          -d '{"udp_enabled": true, "udp_mode": "<%= gcs_udp[:mode] %>", "udp_host": "<%= gcs_udp[:host] %>", "radio_enabled": false, "priority": "udp"}'
          http://127.0.0.1:8199/gateway/config && echo && wait
        - >-
          nginx -g 'daemon off;' &
          sleep 1 && echo "rcpilot GCS: http://$(hostname -I | awk '{print $1}'):8080" && wait
  <% end %>

  - qgc:
      layout: even-horizontal
      panes:
        <% if headless %>
        - echo "Headless mode, not launching QGroundControl."
        <% else %>
        - >
          <% if num_quads > 0 %>
          sed -i 's/virtualJoystickAutoCenterThrottle=false/virtualJoystickAutoCenterThrottle=true/g' /home/qgcuser/.config/QGroundControl/QGroundControl.ini &&
          <% end %>
          gosu qgcuser /squashfs-root/AppRun &
          (
            PRIMARY_RES=$(xrandr | grep -oE '[0-9]+x[0-9]+' | head -1)
            SCREEN_W=$(echo $PRIMARY_RES | cut -d'x' -f1); SCREEN_H=$(echo $PRIMARY_RES | cut -d'x' -f2)
            SCREEN_SCALE=$((SCREEN_H * 100 / 1080)) # Full HD = 100%
            WIN_W=$(( 800 * SCREEN_SCALE / 100 )); WIN_H=$(( 480 * SCREEN_SCALE / 100 ))
            POS_X=$((SCREEN_W - WIN_W)); POS_Y=$((4096))
            for i in {1..15}; do
              TARGET_NAME="QGroundControl"
              CURRENT_DESK=$(wmctrl -d | grep '*' | awk '{print $1}')
              WID=$(wmctrl -l | awk -v d="$CURRENT_DESK" -v n="$TARGET_NAME" '$2 == d && $0 ~ n "$" {print $1}' | head -n 1)
              if [ -n "$WID" ]; then
                wmctrl -i -r "$WID" -e "0,$POS_X,$POS_Y,$WIN_W,$WIN_H" && break
              fi
              sleep 2
            done
          )
        <% end %>
