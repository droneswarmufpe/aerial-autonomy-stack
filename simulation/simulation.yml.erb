<% 
  require 'json'
  require 'open3'
  require 'shellwords'

  headless = ENV.fetch('HEADLESS', 'false') == 'true'

  # Scenario (world, vehicles, custom objects), resolved by scenario.py; NUM_QUADS/NUM_VTOLS limit its vehicles (empty = all)
  scenario_file = ENV.fetch('SCENARIO_FILE', '/aas/simulation_resources/scenarios/default.json')
  num_quads_limit = ENV.fetch('NUM_QUADS', '')
  num_vtols_limit = ENV.fetch('NUM_VTOLS', '')
  scenario_json, scenario_errors, status = Open3.capture3('python3', '/aas/simulation_resources/scripts/scenario.py', scenario_file,
                                                         '--num-quads', num_quads_limit, '--num-vtols', num_vtols_limit)
  raise "Invalid scenario #{scenario_file}:\n#{scenario_errors}" unless status.success?
  scenario = JSON.parse(scenario_json)
  world = scenario['world']
  drones = scenario['drones']
  num_quads = scenario['num_quads']
  num_vtols = scenario['num_vtols']

  sim_subnet = ENV.fetch('SIM_SUBNET', '10.42')
  ground_id = ENV.fetch('GROUND_ID', '101')
  
  jetson = ENV.fetch('JETSON', 'false') == 'true'
  jetson_ips = ENV.fetch('JETSON_IPS', '192.168.55.1').split(',').map(&:strip) # One Jetson per drone, in drone ID order
  
  gnd_container = ENV.fetch('GND_CONTAINER', 'true') == 'true'
  centralized = ENV.fetch('CENTRALIZED', 'false') == 'true'

  simulated_time = ENV.fetch('SIMULATED_TIME', 'false') == 'true'
  rtf = ENV.fetch('RTF', '1.0').to_f
  start_as_paused = ENV.fetch('START_AS_PAUSED', 'false') == 'true'

  gymnasium = ENV.fetch('GYMNASIUM', 'false') == 'true'
  gym_freq_hz = ENV.fetch('GYM_FREQ_HZ', 50).to_i
  gym_init_duration = ENV.fetch('GYM_INIT_DURATION', '80.0').to_f

  generated_dir = '/tmp/aas_generated' # Generated aircraft models and world (by build_world.py), kept out of /aas/simulation_resources
  resource_dirs = %w[aircraft/vehicles aircraft/sensors aircraft/payloads objects world_models worlds].map { |d| "/aas/simulation_resources/#{d}" } # Gazebo model:// lookup

  if rtf <= 0.0
    speedup = 10 # 0.0 or negative RTF: limit to 10 speedup for ArduPilot SITL stability
  else
    speedup = rtf.ceil # Positive RTF: round up to the nearest integer
  end

  # Compute step size for gymnasium based on physics frequency in the world SDF files (ArduPilot worlds use 2ms)
  physics_freq_hz = 500
  physics_dt = 0.002
  gym_step_size = (physics_freq_hz / gym_freq_hz).to_i
  gym_step_size = 1 if gym_step_size < 1
%>

name: sim

windows:

  - gz_sim:
      layout: tiled
      panes:
        - clear && echo "So nice to have you with us, this is the simulation container."
        - WORLD=<%= world %> python3 /aas/simulation_resources/scripts/gz_wind.py --stop_wind
        - >
          python3 /aas/simulation_resources/scripts/build_world.py <%= Shellwords.escape(scenario_file) %> --num-quads <%= num_quads %> --num-vtols <%= num_vtols %>
          --real-time-factor <%= speedup %> --output <%= generated_dir %> &&
          GZ_SIM_SYSTEM_PLUGIN_PATH=/aas/github_apps/ardupilot_gazebo/build:$GZ_SIM_SYSTEM_PLUGIN_PATH 
          GZ_SIM_RESOURCE_PATH=<%= generated_dir %>:$GZ_SIM_RESOURCE_PATH:<%= resource_dirs.join(':') %> 
          GZ_SIM_PHYSICS_ENGINE_PATH=$GZ_SIM_PHYSICS_ENGINE_PATH:/usr/lib/x86_64-linux-gnu/gz-physics-7/engine-plugins/
          gz sim -v2 <%= start_as_paused ? '' : '-r' %> <%= headless ? '-s' : '' %> <%= generated_dir %>/world.sdf

  <% drones.each do |drone| %>
  <% 
    sitl_instance = drone['sitl_instance']
    drone_id = drone['id']
    is_quad = drone['type'] == 'quad'
    vehicle_config = is_quad ? '-v ArduCopter -f gazebo-iris' : '-v ArduPlane'
    model_name = drone['model_name']
    sensor_path = is_quad ? 'model/iris/' : ''
    rgbd_camera = drone['camera'] && drone['rgbd_camera']
    thermal_camera = drone['camera'] && drone['thermal_camera']
    vio_bridge = drone['vio_bridge']

    rgb_camera_topic = "/world/#{world}/model/#{model_name}/#{sensor_path}model/d435/link/base_footprint/sensor/d435_color/image"
    infrared_1_camera_topic = "/world/#{world}/model/#{model_name}/#{sensor_path}model/d435/link/base_footprint/sensor/d435_ired1/image"
    infrared_2_camera_topic = "/world/#{world}/model/#{model_name}/#{sensor_path}model/d435/link/base_footprint/sensor/d435_ired2/image"
    depth_camera_topic = "/world/#{world}/model/#{model_name}/#{sensor_path}model/d435/link/base_footprint/sensor/d435_depth/image"
    thermal_camera_topic = "/world/#{world}/model/#{model_name}/#{sensor_path}model/simple_thermal_camera/link/thermal_cam/base_link/sensor/thermal_imager/image"

    jetson_ip = jetson_ips[sitl_instance]
    if jetson # Each drone streams to its own Jetson
      camera_target_ip = jetson_ip
      rgb_camera_port = 5600
      infrared_1_camera_port = 5700
      infrared_2_camera_port = 5710
      depth_camera_port = 5720
      thermal_camera_port = 5800
    elsif centralized
      camera_target_ip = "#{sim_subnet}.90.#{ground_id}"
      rgb_camera_port = 5600 + sitl_instance
      infrared_1_camera_port = 5700 + sitl_instance
      infrared_2_camera_port = 5710 + sitl_instance
      depth_camera_port = 5720 + sitl_instance
      thermal_camera_port = 5800 + sitl_instance
    else
      camera_target_ip = "#{sim_subnet}.90.#{drone_id}"
      rgb_camera_port = 5600
      infrared_1_camera_port = 5700
      infrared_2_camera_port = 5710
      depth_camera_port = 5720
      thermal_camera_port = 5800
    end
  %>
  - ardu_sitl_<%= drone_id %>:
      layout: main-horizontal
      panes:
        - >
          sleep <%= sitl_instance * 3.0 %> && mkdir -p /aas/ardu_sitl_<%= drone_id %> && cd /aas/ardu_sitl_<%= drone_id %> &&
          /aas/github_apps/ardupilot/Tools/autotest/sim_vehicle.py
          --mavproxy-args="--streamrate=-1"
          <%= vehicle_config %> --model JSON
          -I <%= sitl_instance %> --sysid <%= drone_id %>
          --speedup <%= speedup %>
          --add-param-file=<%= generated_dir %>/<%= model_name %>/ardupilot-4.6.params
          -l $(python3 /aas/simulation_resources/scripts/extract_spherical_coords.py /aas/simulation_resources/worlds/<%= world %>.sdf)
          <% if jetson %>
          --out=udp:<%= jetson_ip %>:14550
          <% elsif centralized %>
          --out=udp:<%= "#{sim_subnet}.90.#{ground_id}" %>:<%= 14570 + drone_id %>
          <% else %>
          --out=udp:<%= "#{sim_subnet}.90.#{drone_id}" %>:14570 
          <% end %>
          <% if gnd_container %>
          --out=udp:<%= "#{sim_subnet}.90.#{ground_id}" %>:<%= 14550 + drone_id%>
          <% else %>
          --out=udp:127.0.0.1:<%= 14550 + sitl_instance %>
          <% end %>
        <% if rgbd_camera %>
        - >
          /aas/simulation_resources/comms/gz_gst_bridge/build/gz_gst_bridge
          <%= rgb_camera_topic %>
          <%= camera_target_ip %> <%= rgb_camera_port %> 8
        <% unless vio_bridge %>
        - >
          /aas/simulation_resources/comms/gz_gst_bridge/build/gz_gst_bridge
          <%= infrared_1_camera_topic %>
          <%= camera_target_ip %> <%= infrared_1_camera_port %> 8
        - >
          /aas/simulation_resources/comms/gz_gst_bridge/build/gz_gst_bridge
          <%= infrared_2_camera_topic %>
          <%= camera_target_ip %> <%= infrared_2_camera_port %> 8
        <% end %>
        - >
          /aas/simulation_resources/comms/gz_gst_bridge/build/gz_gst_bridge
          <%= depth_camera_topic %>
          <%= camera_target_ip %> <%= depth_camera_port %> 8
        <% end %>
        <% if vio_bridge %>
        - >
          ROS_DOMAIN_ID=<%= drone_id %> ros2 run vio_bridge stereo_bridge --ros-args
          -p use_sim_time:=true
          -p gz_topic0:=<%= infrared_1_camera_topic %>
          -p gz_topic1:=<%= infrared_2_camera_topic %>
        - >
          ROS_DOMAIN_ID=<%= drone_id %> ros2 run ros_gz_bridge parameter_bridge
          /world/<%= world %>/model/<%= model_name %>/model/iris/link/imu_link/sensor/imu_sensor/imu@sensor_msgs/msg/Imu[gz.msgs.IMU
          --ros-args -p use_sim_time:=true
          -r /world/<%= world %>/model/<%= model_name %>/model/iris/link/imu_link/sensor/imu_sensor/imu:=/vio/imu
        <% end %>
        <% if thermal_camera %>
        - >
          /aas/simulation_resources/comms/gz_gst_bridge/build/gz_gst_bridge
          <%= thermal_camera_topic %>
          <%= camera_target_ip %> <%= thermal_camera_port %> 8
        <% end %>
        - "ROS_DOMAIN_ID=<%= drone_id %> ros2 run ros_gz_bridge parameter_bridge /clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock"
  <% end %>

  <% unless gnd_container %>
  - qgc:
      layout: even-horizontal
      panes:
        <% if headless %>
        - echo "Headless mode, not launching QGroundControl."
        <% else %>
        - >
          <% if num_quads > 0 %>
          sed -i 's/virtualJoystickAutoCenterThrottle=false/virtualJoystickAutoCenterThrottle=true/g' /home/qgcuser/.config/QGroundControl/QGroundControl.ini &&
          <% end %>
          gosu qgcuser /squashfs-root/AppRun &
          (
            PRIMARY_RES=$(xrandr | grep -oE '[0-9]+x[0-9]+' | head -1)
            SCREEN_W=$(echo $PRIMARY_RES | cut -d'x' -f1); SCREEN_H=$(echo $PRIMARY_RES | cut -d'x' -f2)
            SCREEN_SCALE=$((SCREEN_H * 100 / 1080)) # Full HD = 100%
            WIN_W=$(( 800 * SCREEN_SCALE / 100 )); WIN_H=$(( 480 * SCREEN_SCALE / 100 ))
            POS_X=$((SCREEN_W - WIN_W)); POS_Y=$((4096))
            for i in {1..15}; do
              TARGET_NAME="QGroundControl"
              CURRENT_DESK=$(wmctrl -d | grep '*' | awk '{print $1}')
              WID=$(wmctrl -l | awk -v d="$CURRENT_DESK" -v n="$TARGET_NAME" '$2 == d && $0 ~ n "$" {print $1}' | head -n 1)
              if [ -n "$WID" ]; then
                wmctrl -i -r "$WID" -e "0,$POS_X,$POS_Y,$WIN_W,$WIN_H" && break
              fi
              sleep 2
            done
          )
        <% end %>
  <% end %>

  - gz_resize_and_clock_bridge:
      layout: even-horizontal
      panes:
        <% unless headless %>
        - >
          (
            PRIMARY_RES=$(xrandr | grep -oE '[0-9]+x[0-9]+' | head -1)
            SCREEN_W=$(echo $PRIMARY_RES | cut -d'x' -f1); SCREEN_H=$(echo $PRIMARY_RES | cut -d'x' -f2)
            SCREEN_SCALE=$((SCREEN_H * 100 / 1080)) # Full HD = 100%
            WIN_W=$(( 800 * SCREEN_SCALE / 100 )); WIN_H=$(( 480 * SCREEN_SCALE / 100 ))
            POS_X=$((SCREEN_W - WIN_W)); POS_Y=$(( 0 ))
            for i in {1..15}; do
              TARGET_NAME="Gazebo Sim"
              CURRENT_DESK=$(wmctrl -d | grep '*' | awk '{print $1}')
              WID=$(wmctrl -l | awk -v d="$CURRENT_DESK" -v n="$TARGET_NAME" '$2 == d && $0 ~ n "$" {print $1}' | head -n 1)
              if [ -n "$WID" ]; then
                wmctrl -i -r "$WID" -e "0,$POS_X,$POS_Y,$WIN_W,$WIN_H" && break
              fi
              sleep 2
            done
          )
        <% end %>
        <% if gnd_container %>
        - "ROS_DOMAIN_ID=<%= ground_id %> ros2 run ros_gz_bridge parameter_bridge /clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock"
        <% else %>
        - ros2 run ros_gz_bridge parameter_bridge /clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock
        <% end %>

  <% if gymnasium %>
  - zmq_bridge:
      layout: even-horizontal
      panes:
        - WORLD=<%= world %> ros2 run zmq_bridge_cpp zmq_bridge_node --ros-args -p init_duration:=<%= gym_init_duration %> -p step_size:=<%= gym_step_size %> -p physics_dt:=<%= physics_dt %>
  <% end %>
