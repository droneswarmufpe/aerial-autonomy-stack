<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="sensor_lidar">
    <link name="lidar/base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.0003443775</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0003443775</iyy>
          <iyz>0</iyz>
          <izz>0.000222</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cone><radius>0.025</radius><length>0.05</length></cone></geometry>
        <material>
          <ambient>0 1 0 1</ambient>
          <diffuse>0 1 0 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar3d" type="gpu_lidar">
        <!-- Livox Mid-360 style upward field of view, matching the previous AAS sensor model. -->
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>120</samples>
              <resolution>1</resolution>
              <min_angle>0.12217</min_angle>
              <max_angle>0.90757</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>70.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.001</stddev>
          </noise>
        </lidar>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>
  </model>
</sdf>
