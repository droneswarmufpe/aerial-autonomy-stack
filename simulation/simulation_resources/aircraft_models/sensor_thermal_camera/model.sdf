<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name="sensor_thermal_camera">
    <link name="thermal_cam/base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00004</iyy>
          <iyz>0</iyz>
          <izz>0.00004</izz>
        </inertia>
      </inertial>
      <sensor name="thermal_imager" type="thermal">
        <camera>
          <horizontal_fov>0.977384</horizontal_fov>
          <image>
            <width>256</width>
            <height>192</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>2000</far>
          </clip>
          <lens>
            <intrinsics>
              <fx>240.8</fx>
              <fy>249.8</fy>
              <cx>127.5</cx>
              <cy>95.5</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
        </camera>
        <always_on>1</always_on>
        <update_rate>25</update_rate>
        <visualize>false</visualize>
        <plugin
          filename="gz-sim-thermal-sensor-system"
          name="gz::sim::systems::ThermalSensor">
          <min_temp>253.15</min_temp>
          <max_temp>873.15</max_temp>
          <resolution>3.0</resolution>
        </plugin>
      </sensor>
      <gravity>true</gravity>
      <velocity_decay/>
    </link>
  </model>
</sdf>
